# ---------------------------------------------------------------------------
# Mybet web – environment variables. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Mybet (Laravel) API, server-side only. Leave EMPTY to run on the built-in
# demo data (demo login, registration code 123456, demo bets).
# Example: https://api.mybet.lk/v1
API_BASE_URL=

# Public site URL (canonical URLs, sitemap.xml, robots.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Footer / contacts
NEXT_PUBLIC_SUPPORT_PHONE=0112345678
NEXT_PUBLIC_ANDROID_APK_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
